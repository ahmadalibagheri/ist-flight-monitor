# ============================================================================
# IST Flight Reliability Monitor - configuration
#
# Copy to .env and fill in. NEVER commit .env - it is git-ignored.
#   cp .env.example .env
# ============================================================================

# ---------------------------------------------------------------- application
ENVIRONMENT=development           # development | staging | production
LOG_LEVEL=INFO
LOG_FORMAT=json                   # json | console
API_PORT=8000
WEB_PORT=3000
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------- database
POSTGRES_USER=flightmon
POSTGRES_PASSWORD=change_me_before_running   # REQUIRED - compose refuses to start without it
POSTGRES_DB=flightmon
POSTGRES_PORT=5432
# Only needed when running the backend outside Docker; compose sets this itself.
DATABASE_URL=postgresql+psycopg://flightmon:change_me_before_running@localhost:5432/flightmon

# ------------------------------------------------------------------- timezone
# Operational timezone. Timestamps are stored in UTC and converted for reports.
OPERATIONAL_TIMEZONE=Europe/Istanbul

# --------------------------------------------------------------------- routes
ORIGIN_AIRPORT=IST
DESTINATION_AIRPORTS=IKA,MHD
INCLUDE_CODESHARE=false           # true counts marketing duplicates as separate flights
INCLUDE_INDIRECT=false

# ============================================================================
# FLIGHT DATA PROVIDER
#
# At least one REAL provider must be configured or collection cannot run.
# Providers are tried in PROVIDER_CHAIN order; the first that returns data wins.
# See docs/PROVIDERS.md for how to obtain each key and what each one costs.
# ============================================================================
PROVIDER_CHAIN=aerodatabox

# How the chain is used:
#   failover - stop at the first provider that answers. Cheapest; extra providers
#              are only insurance against an outage.
#   merge    - query EVERY configured provider and combine their views per flight,
#              so a source that knows the gate fills in for one that only knows the
#              schedule. Costs one call set per provider per cycle.
# Chain order is also the trust order: earlier providers win contested fields,
# except that an *observed* actual time always beats a mere estimate.
PROVIDER_STRATEGY=failover

# --- AeroDataBox (recommended default) --------------------------------------
# Sign up: https://rapidapi.com/aedbx-aedbx/api/aerodatabox  (free tier: 600 calls/month)
# or direct: https://aerodatabox.com/pricing
AERODATABOX_API_KEY=
AERODATABOX_BASE_URL=https://aerodatabox.p.rapidapi.com
AERODATABOX_AUTH_HEADER=X-RapidAPI-Key
AERODATABOX_HOST_HEADER=aerodatabox.p.rapidapi.com
# For a DIRECT (non-RapidAPI) subscription, use the values your dashboard shows,
# and clear the host header:
#   AERODATABOX_BASE_URL=https://api.aerodatabox.com
#   AERODATABOX_AUTH_HEADER=x-api-key
#   AERODATABOX_HOST_HEADER=

# --- AviationStack (optional secondary) -------------------------------------
# Sign up: https://aviationstack.com/product
# NOTE: the free tier is HTTP-ONLY (no TLS) and ~100 requests/month. On the free
# tier you must set the base URL to http:// - your key then travels in cleartext,
# so treat a free-tier key as disposable and never reuse it elsewhere.
AVIATIONSTACK_API_KEY=
AVIATIONSTACK_BASE_URL=https://api.aviationstack.com/v1

# --- FlightAware AeroAPI (optional, highest quality, billed per result) ------
# Sign up: https://www.flightaware.com/aeroapi/portal/
FLIGHTAWARE_API_KEY=
FLIGHTAWARE_BASE_URL=https://aeroapi.flightaware.com/aeroapi

# --- Development only --------------------------------------------------------
# Emits SYNTHETIC flights so the dashboard can be exercised without API quota.
# Refuses to run when ENVIRONMENT=production. Everything it produces is tagged
# is_mock=true and is excluded from every analytic. Add "mock" to PROVIDER_CHAIN
# to actually use it.
ALLOW_MOCK_PROVIDER=false

# ------------------------------------------------------------------ collector
COLLECTION_INTERVAL_MINUTES=60    # allowed: 5 | 15 | 30 | 60
COLLECTION_LOOKAHEAD_HOURS=36
COLLECTION_LOOKBACK_HOURS=6
COLLECTION_TIMEOUT_SECONDS=30
COLLECTION_MAX_RETRIES=4
COLLECTION_BACKOFF_BASE_SECONDS=1.5
COLLECTION_BACKOFF_MAX_SECONDS=60
STALE_AFTER_MINUTES=180           # absent this long => marked stale, NOT cancelled
# Keep each provider response verbatim (~1 KB/observation). Historical responses
# cannot be re-fetched, so anything not stored now is lost permanently.
STORE_RAW_PAYLOAD=true

PROVIDER_CACHE_TTL_SECONDS=240    # cost control: dedupes identical upstream calls
PROVIDER_FAILURE_THRESHOLD=3
PROVIDER_RECOVERY_SECONDS=900

# ------------------------------------------------------------------ analytics
DELAY_THRESHOLD_MINUTES=15
DELAY_BUCKETS_MINUTES=15,30,60,120
MIN_SAMPLE_SIZE_AIRLINE=20        # below this an airline is never ranked
MIN_SAMPLE_SIZE_FLIGHT=10
MIN_SAMPLE_SIZE_PERIOD=10

# ------------------------------------------- reliability score (must sum to 1)
SCORE_WEIGHT_ON_TIME=0.35
SCORE_WEIGHT_CANCELLATION=0.30
SCORE_WEIGHT_AVG_DELAY=0.20
SCORE_WEIGHT_SEVERE_DELAY=0.15
# Value at which each component scores zero.
SCORE_MAX_CANCELLATION_RATE=0.25
SCORE_MAX_AVG_DELAY_MINUTES=90
SCORE_MAX_SEVERE_DELAY_RATE=0.35

# -------------------------------------------------------------------- reports
REPORT_INTERVAL_MINUTES=60
DAILY_REPORT_HOUR_LOCAL=23
HISTORICAL_REPORT_DAYS=30
AGGREGATION_INTERVAL_MINUTES=30

# ============================================================================
# TELEGRAM
# 1. Talk to @BotFather, /newbot, copy the token below.
# 2. Send your bot a message, then open
#      https://api.telegram.org/bot<TOKEN>/getUpdates
#    and copy "chat":{"id":...} into TELEGRAM_CHAT_ID.
#    For a group, add the bot to the group first; group ids are negative.
# Leave the token blank to disable Telegram entirely.
# ============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true
TELEGRAM_SEND_HOURLY_REPORT=true
TELEGRAM_ALERT_DELAY_MINUTES=60,120
TELEGRAM_ALERT_ON_CANCELLATION=true
TELEGRAM_ROUTE_DISRUPTION_RATE=0.20
TELEGRAM_ROUTE_DISRUPTION_MIN_FLIGHTS=4
TELEGRAM_TIMEOUT_SECONDS=15

# ------------------------------------------------------------------ scheduler
SCHEDULER_ENABLED=true

# ------------------------------------------------------------------- frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
