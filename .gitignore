# --- local machine overrides ---
# Compose override files are per-machine by convention. Committing one would ship a
# local choice (here: worker disabled because cron owns the schedule) to everyone,
# leaving a fresh clone with no scheduler at all.
docker-compose.override.yml

# --- runtime ---
logs/
*.log

# --- build artefacts ---
*.tsbuildinfo
